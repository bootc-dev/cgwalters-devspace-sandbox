From c8d48bb9f574238a74e6fa526d2da6fbf4a74574 Mon Sep 17 00:00:00 2001
From: agent <agent@localhost>
Date: Thu, 5 Nov 2026 01:19:49 +0000
Subject: [PATCH 3/5] sysroot: Read the booted boot filesystem from
 /sysroot/boot

When /boot is a directory of the physical root, the deployment's /boot is
just a bind mount of /sysroot/boot made by the boot.mount generator, and
other units can stack mounts on top of it. On a BIOS-booted system with an
unused ESP, systemd-gpt-auto-generator puts boot.automount for the ESP
there. Once that automount idles out, accessing /boot from another mount
namespace fails with EPERM, so e.g. `unshare -m ostree admin status`
fails with "fstatat(boot/loader): Operation not permitted".

On a booted system, open boot_fd from /sysroot/boot in that case; that
path has nothing stacked on it. With a separate boot partition, keep using
/boot.

`finalize-staged --hold` relied on the sysroot's boot_fd to keep /boot
busy until shutdown. Now that the fd may be for /sysroot/boot, open /boot
explicitly. Without that, the automount expires, which stops boot.mount
and with it ostree-finalize-staged.service (RequiresMountsFor=/boot), so
finalization runs right away and blocks in the automount's expiry.

Related: https://github.com/bootc-dev/bootc/issues/2402

Assisted-by: https://github.com/cgwalters/cgwalters#llms
---
 src/libostree/ostree-sysroot.c                | 32 ++++++++++++++++---
 src/ostree/ot-admin-builtin-finalize-staged.c |  8 ++++-
 2 files changed, 35 insertions(+), 5 deletions(-)

diff --git a/src/libostree/ostree-sysroot.c b/src/libostree/ostree-sysroot.c
index 3f257bec..66a0f11d 100644
--- a/src/libostree/ostree-sysroot.c
+++ b/src/libostree/ostree-sysroot.c
@@ -353,6 +353,30 @@ validate_boot_fd (OstreeSysroot *self, int fd, GError **error)
   return TRUE;
 }
 
+/* Path to the boot filesystem of a booted system. When /boot is a directory of
+ * the physical root, the deployment's /boot is only a bind mount of it made by
+ * ostree-system-generator, and other units can stack an automount on that
+ * path; systemd-gpt-auto-generator does for an unused ESP, e.g. when booted
+ * via BIOS. Once that automount expires, /boot is no longer reachable from
+ * another mount namespace (EPERM), so use the source, which always is.
+ */
+static const char *
+booted_boot_path (void)
+{
+  if (otcore_boot_is_on_physical_root ("/sysroot"))
+    return "/sysroot/boot";
+  return "/boot";
+}
+
+/* Open the boot/ directory, or return -1 with errno set */
+static int
+open_boot_dir (OstreeSysroot *self)
+{
+  if (self->root_is_ostree_booted)
+    return glnx_opendirat_with_errno (AT_FDCWD, booted_boot_path (), TRUE);
+  return glnx_opendirat_with_errno (self->sysroot_fd, "boot", TRUE);
+}
+
 /* Require that both self->sysroot_fd is set.
  * If the sysroot has a boot/ subdirectory, it will be loaded.
  * If not, self->boot_fd will remain -1.
@@ -367,7 +391,7 @@ _ostree_sysroot_maybe_load_boot_fd (OstreeSysroot *self, GError **error)
     return FALSE;
   if (self->boot_fd == -1)
     {
-      glnx_autofd int fd = glnx_opendirat_with_errno (self->sysroot_fd, "boot", TRUE);
+      glnx_autofd int fd = open_boot_dir (self);
       if (fd < 0)
         {
           if (errno != ENOENT)
@@ -391,9 +415,9 @@ _ostree_sysroot_ensure_boot_fd (OstreeSysroot *self, GError **error)
     return FALSE;
   if (self->boot_fd == -1)
     {
-      glnx_autofd int fd = -1;
-      if (!glnx_opendirat (self->sysroot_fd, "boot", TRUE, &fd, error))
-        return FALSE;
+      glnx_autofd int fd = open_boot_dir (self);
+      if (fd < 0)
+        return glnx_throw_errno_prefix (error, "opendir(boot)");
       if (!validate_boot_fd (self, fd, error))
         return FALSE;
       self->boot_fd = glnx_steal_fd (&fd);
diff --git a/src/ostree/ot-admin-builtin-finalize-staged.c b/src/ostree/ot-admin-builtin-finalize-staged.c
index 1e5c2df1..8a443311 100644
--- a/src/ostree/ot-admin-builtin-finalize-staged.c
+++ b/src/ostree/ot-admin-builtin-finalize-staged.c
@@ -71,11 +71,17 @@ ot_admin_builtin_finalize_staged (int argc, char **argv, OstreeCommandInvocation
               cancellable, error))
         return FALSE;
 
-      /* By default the sysroot now holds a file descriptor for /boot open.
+      /* Hold /boot open so that an automount there doesn't expire: that
+       * would stop boot.mount, and with it ostree-finalize-staged.service,
+       * which has RequiresMountsFor=/boot, finalizing far too early. The
+       * sysroot's own fd may be for /sysroot/boot instead, so open the path.
        * We want that open until the deployment is finalized during
        * system shutdown, so block until we get SIGTERM which systemd will send
        * when the unit is stopped, then we'll exit and release it.
        */
+      glnx_autofd int boot_fd = -1;
+      if (!glnx_opendirat (AT_FDCWD, "/boot", TRUE, &boot_fd, error))
+        return FALSE;
       pause ();
     }
   else
