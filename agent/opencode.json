{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["praxis"],
  "model": "praxis/gpt-5.6-terra",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "praxis": {
      "name": "Praxis credential broker",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "",
        "apiKey": "unused"
      },
      "models": {
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol", "limit": { "context": 200000, "output": 128000 } },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra", "limit": { "context": 200000, "output": 128000 } },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna", "limit": { "context": 200000, "output": 65536 } }
      }
    }
  }
}
