+  gboolean boot_is_detached;
   // Lock for this sysroot.
   GLnxLockFile lock;
 
@@ -186,6 +189,10 @@ char *_ostree_sysroot_join_lines (GPtrArray *lines);
 
 gboolean _ostree_sysroot_ensure_boot_fd (OstreeSysroot *self, GError **error);
 
