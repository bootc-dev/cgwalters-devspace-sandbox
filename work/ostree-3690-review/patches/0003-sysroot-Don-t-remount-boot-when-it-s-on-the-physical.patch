From 3b771da6c16e799988d66fdda47863009d71e909 Mon Sep 17 00:00:00 2001
From: cgwalters-bot <cgwalters-bot@users.noreply.github.com>
Date: Fri, 6 Nov 2026 20:42:12 +0000
Subject: [PATCH 3/4] sysroot: Don't remount /boot when it's on the physical
 root

ostree-finalize-staged.service remounts /boot read-write at shutdown. When
/boot is the generator's bind mount with an expired boot.automount on
top, that fails with "Remounting /boot read-write: Invalid argument",
and the staged deployment is silently dropped.

When /boot is a directory of the physical root, boot_fd now comes from
/sysroot/boot, which remounting /sysroot already makes writable, so
there is nothing to remount at /boot. Only remount /boot when it is its
own filesystem, as before.

The path-based bootloader backends (grub2-mkconfig, syslinux, uboot,
zipl, aboot) still write through /boot, but systems using them have a
separate /boot partition, where nothing changes.

Related: https://github.com/bootc-dev/bootc/issues/2402

Assisted-by: https://github.com/cgwalters/cgwalters#llms
---
 src/libostree/ostree-sysroot.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/libostree/ostree-sysroot.c b/src/libostree/ostree-sysroot.c
index 419b11a3..daa582cb 100644
--- a/src/libostree/ostree-sysroot.c
+++ b/src/libostree/ostree-sysroot.c
@@ -239,8 +239,8 @@ ostree_sysroot_new_default (void)
  *
  * If this function has been called, then when a function which requires
  * writable access is invoked, libostree will automatically remount as writable
- * any mount points on which it operates.  This currently is just `/sysroot` and
- * `/boot`.
+ * any mount points on which it operates.  This currently is just `/sysroot` and,
+ * if it is a separate filesystem, `/boot`.
  *
  * If you invoke this function, it must be before ostree_sysroot_load(); it may
  * be invoked before or after ostree_sysroot_initialize().
@@ -475,9 +475,18 @@ _ostree_sysroot_ensure_writable (OstreeSysroot *self, GError **error)
   gboolean did_remount_sysroot = FALSE;
   if (!remount_writable ("/sysroot", &did_remount_sysroot, error))
     return FALSE;
-  gboolean did_remount_boot = FALSE;
-  if (!remount_writable ("/boot", &did_remount_boot, error))
-    return FALSE;
+
+  /* When /boot is a directory of the physical root, boot_fd is opened from
+   * /sysroot/boot, which is now writable. /boot is then only a bind mount of it
+   * that may have an automount stacked on top (see booted_boot_path()), so
+   * leave it alone. Otherwise /boot is its own filesystem; remount it.
+   */
+  if (!otcore_boot_is_on_physical_root ("/sysroot"))
+    {
+      gboolean did_remount_boot = FALSE;
+      if (!remount_writable ("/boot", &did_remount_boot, error))
+        return FALSE;
+    }
 
   /* Now close and reopen our file descriptors */
   ostree_sysroot_unload (self);
-- 
