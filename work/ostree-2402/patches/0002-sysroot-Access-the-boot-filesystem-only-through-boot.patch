     return FALSE;
   if (errno == ENOENT)
     {
@@ -744,7 +747,7 @@ read_current_bootversion (OstreeSysroot *self, int *out_bootversion, GCancellabl
         return glnx_throw (error, "Not a symbolic link: boot/loader");
 
