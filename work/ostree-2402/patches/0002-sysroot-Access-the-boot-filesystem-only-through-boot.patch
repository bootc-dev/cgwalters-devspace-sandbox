+        errno = ENOENT;
+      else if (!glnx_fstatat_allow_noent (self->boot_fd, "loader", NULL, AT_SYMLINK_NOFOLLOW,
+                                          error))
         return FALSE;
       if (errno == ENOENT)
         {
