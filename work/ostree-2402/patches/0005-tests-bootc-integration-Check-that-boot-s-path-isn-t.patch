From 934bc7750c1b81b2d0d0a77d4338c2401952219b Mon Sep 17 00:00:00 2001
From: Colin Walters <walters@verbum.org>
Date: Sat, 7 Nov 2026 01:44:17 +0000
Subject: [PATCH 5/5] tests/bootc-integration: Check that /boot's path isn't
 needed

Cover bootc#2402: with an empty tmpfs over /boot in a private mount
namespace, as with an expired automount stacked on it, status and
`kargs edit-in-place` must still read and write the real entries.

Assisted-by: https://github.com/cgwalters/cgwalters#llms
---
 .../bootc-integration/src/tests/privileged.rs | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/tests/bootc-integration/src/tests/privileged.rs b/tests/bootc-integration/src/tests/privileged.rs
index adc64563..39384665 100644
--- a/tests/bootc-integration/src/tests/privileged.rs
+++ b/tests/bootc-integration/src/tests/privileged.rs
@@ -181,6 +181,37 @@ booted_test!(privileged_verify_osinit_unshare, {
     Ok(())
 });
 
+// https://github.com/bootc-dev/bootc/issues/2402
+booted_test!(privileged_verify_boot_path_not_required, {
+    let sh = Shell::new()?;
+    // This is about /boot being on the physical root, where the deployment's
+    // /boot is just a bind mount of /sysroot/boot.
+    let loader = std::fs::symlink_metadata("/sysroot/boot/loader")?;
+    if !loader.file_type().is_symlink() {
+        return Ok(());
+    }
+
+    // In a new mount namespace, put an empty tmpfs over /boot: like an
+    // automount stacked on it that has expired, /boot is then not the boot
+    // filesystem. Reading and writing the bootloader entries must still work.
+    let karg = "ostree.test-boot-path=1";
+    let script = format!(
+        "mount -t tmpfs tmpfs /boot && ostree admin status && \
+         ostree admin kargs edit-in-place --append-if-missing={karg}"
+    );
+    cmd!(sh, "unshare -m --propagation private sh -c {script}").run()?;
+
+    // The real entries have the new karg
+    let entries = cmd!(sh, "grep -l -r -F {karg} /boot/loader/entries")
+        .ignore_status()
+        .read()?;
+    ensure!(
+        !entries.is_empty(),
+        "{karg} not found in /boot/loader/entries; was it written to the tmpfs?"
+    );
+    Ok(())
+});
+
 privileged_test!(privileged_verify_nofifo, {
     let sh = Shell::new()?;
     let tmp = tempfile::tempdir()?;
