From aad548915d5bf3f8763cd3839f9ed1b04df0f0ad Mon Sep 17 00:00:00 2001
From: boot-2402 spike <noreply@example.invalid>
Date: Sun, 8 Nov 2026 23:58:08 +0000
Subject: [PATCH 6/6] finalize-staged: Only want /boot, so its automount
 expiring is harmless

---
 src/boot/ostree-finalize-staged-hold.service  |  4 +++-
 src/boot/ostree-finalize-staged.service       |  7 +++++-
 src/ostree/ot-admin-builtin-finalize-staged.c | 24 ++++---------------
 3 files changed, 14 insertions(+), 21 deletions(-)

diff --git a/src/boot/ostree-finalize-staged-hold.service b/src/boot/ostree-finalize-staged-hold.service
index 85b5d543..5b62fc68 100644
--- a/src/boot/ostree-finalize-staged-hold.service
+++ b/src/boot/ostree-finalize-staged-hold.service
@@ -21,7 +21,9 @@ Documentation=man:ostree(1)
 ConditionPathExists=/run/ostree-booted
 DefaultDependencies=no
 
-RequiresMountsFor=/sysroot /boot
+RequiresMountsFor=/sysroot
+# See ostree-finalize-staged.service
+WantsMountsFor=/boot
 After=local-fs.target
 Before=basic.target final.target
 
diff --git a/src/boot/ostree-finalize-staged.service b/src/boot/ostree-finalize-staged.service
index 897b1da1..c85451c9 100644
--- a/src/boot/ostree-finalize-staged.service
+++ b/src/boot/ostree-finalize-staged.service
@@ -21,7 +21,12 @@ Documentation=man:ostree(1)
 ConditionPathExists=/run/ostree-booted
 DefaultDependencies=no
 
-RequiresMountsFor=/sysroot /boot /etc
+RequiresMountsFor=/sysroot /etc
+# /boot is only wanted, which still orders us before it is unmounted. Finalizing
+# doesn't use the /boot path (see open_boot_dir() in ostree-sysroot.c), and if
+# /boot is an automount, requiring it would stop this unit, and so finalize the
+# deployment, as soon as the automount expires.
+WantsMountsFor=/boot
 After=local-fs.target
 Before=basic.target final.target
 # We want to make sure the transaction logs are persisted to disk:
diff --git a/src/ostree/ot-admin-builtin-finalize-staged.c b/src/ostree/ot-admin-builtin-finalize-staged.c
index ac37faf1..df384fcb 100644
--- a/src/ostree/ot-admin-builtin-finalize-staged.c
+++ b/src/ostree/ot-admin-builtin-finalize-staged.c
@@ -72,27 +72,13 @@ ot_admin_builtin_finalize_staged (int argc, char **argv, OstreeCommandInvocation
         return FALSE;
 
       /* By default the sysroot now holds a file descriptor for the boot
-       * filesystem open. When /boot is on the physical root, that fd is for
-       * /sysroot/boot, and /boot is only a bind mount of it, on which
-       * systemd-gpt-auto-generator may have stacked an automount. Hold that
-       * bind mount open as well: if the automount expired, stopping boot.mount
-       * would stop ostree-finalize-staged.service (RequiresMountsFor=/boot) and
-       * finalize far too early. Anything else at /boot, such as an ESP, isn't
-       * ours to hold.
-       * We want these open until the deployment is finalized during
+       * filesystem open: /sysroot/boot, or a detached mount of a separate
+       * /boot. Neither keeps an automount at /boot from expiring; that no
+       * longer matters, since ostree-finalize-staged.service only wants /boot.
+       * We want that open until the deployment is finalized during
        * system shutdown, so block until we get SIGTERM which systemd will send
-       * when the unit is stopped, then we'll exit and release them.
+       * when the unit is stopped, then we'll exit and release it.
        */
-      glnx_autofd int boot_fd = -1;
-      if (!glnx_opendirat (AT_FDCWD, "/boot", TRUE, &boot_fd, error))
-        return FALSE;
-      struct stat boot_stbuf;
-      if (!glnx_fstat (boot_fd, &boot_stbuf, error))
-        return FALSE;
-      if (!glnx_fstatat_allow_noent (AT_FDCWD, "/sysroot/boot", &stbuf, 0, error))
-        return FALSE;
-      if (errno == ENOENT || boot_stbuf.st_dev != stbuf.st_dev || boot_stbuf.st_ino != stbuf.st_ino)
-        glnx_close_fd (&boot_fd);
       pause ();
     }
   else
