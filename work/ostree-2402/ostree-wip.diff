+   * accept. The directory fd holds its own reference to the clone, which
+   * stays usable after tree_fd is closed, as with a lazy unmount.
+   */
+  if (!glnx_opendirat (tree_fd, ".", TRUE, out_fd, error))
+    return FALSE;
+  g_debug ("using a writable clone of %s", path);
+#endif
+  return TRUE;
