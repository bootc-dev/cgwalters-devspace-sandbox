# Build ostree RPMs from a source checkout (build context `ostree`) and
# layer them onto localhost/bootc.
FROM quay.io/fedora/fedora:44 AS rpmbuild
RUN dnf -y install dnf5-plugins rpm-build git make
COPY --from=ostree . /src
WORKDIR /src
RUN <<EORUN
set -xeuo pipefail
git config --global --add safe.directory '*'
git submodule update --init
ci/make-git-snapshot.sh
ci/packit-fix-spec.sh ostree.spec
rpmbuild -bs --define "_sourcedir ${PWD}" --define "_specdir ${PWD}" --define "_builddir ${PWD}" --define "_srcrpmdir ${PWD}" --define "_rpmdir ${PWD}" --define "_buildrootdir ${PWD}/.build" ostree.spec
dnf builddep -y *.src.rpm
ci/rpmbuild-cwd --nocheck --rebuild *.src.rpm
mkdir -p /rpms
find . -name '*.rpm' -not -name '*.src.rpm' -exec mv {} /rpms/ \;
EORUN

FROM localhost/bootc
COPY --from=rpmbuild /rpms /tmp/rpms
RUN rpm -Uvh --force $(ls /tmp/rpms/ostree-*.rpm | grep -v -e devel -e debug -e tests -e grub2) && rm -rf /tmp/rpms && ostree --version
