From 890ca37686a453b7e5cb67eb967ef09067d47b8d Mon Sep 17 00:00:00 2001
From: cgwalters-bot <cgwalters-bot@users.noreply.github.com>
Date: Thu, 5 Nov 2026 07:26:35 -0500
Subject: [PATCH 1/4] otcore: Add a helper to check for /boot on the physical
 root

otcore_mount_boot() and the boot.mount generator both check whether /boot
is a directory of the physical root by looking for the boot/loader symlink
there. Factor that into otcore_boot_is_on_physical_root(); the next
commits use it from libostree too.

Assisted-by: https://github.com/cgwalters/cgwalters#llms
---
 src/libostree/ostree-impl-system-generator.c |  7 ++-----
 src/libotcore/otcore-prepare-root.c          | 18 ++++++++++++++++--
 src/libotcore/otcore.h                       |  1 +
 3 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/src/libostree/ostree-impl-system-generator.c b/src/libostree/ostree-impl-system-generator.c
index 6332fc74..ab648880 100644
--- a/src/libostree/ostree-impl-system-generator.c
+++ b/src/libostree/ostree-impl-system-generator.c
@@ -301,11 +301,8 @@ boot_mount_generator (const char *normal_dir, GError **error)
   static const char boot_path[] = "/boot";
   struct stat stbuf;
 
-  /* Check if /boot is on the same partition as /sysroot by looking for
-   * /sysroot/boot/loader as a symlink. This is the same check used by
-   * otcore_mount_boot() in the initramfs path.
-   */
-  if (!(lstat ("/sysroot/boot/loader", &stbuf) == 0 && S_ISLNK (stbuf.st_mode)))
+  /* This is the same check used by otcore_mount_boot() in the initramfs path. */
+  if (!otcore_boot_is_on_physical_root ("/sysroot"))
     return TRUE; /* /boot is a separate partition, systemd handles it */
 
   /* Verify the target /boot directory exists */
diff --git a/src/libotcore/otcore-prepare-root.c b/src/libotcore/otcore-prepare-root.c
index e938900d..839545a6 100644
--- a/src/libotcore/otcore-prepare-root.c
+++ b/src/libotcore/otcore-prepare-root.c
@@ -448,6 +448,21 @@ composefs_error_message (int errsv)
 
 #endif
 
+/**
+ * otcore_boot_is_on_physical_root:
+ *
+ * Returns: %TRUE if /boot is a directory of the physical root filesystem rather
+ * than a separate partition, which we detect by the boot/loader symlink being
+ * present there; with a separate partition, boot/ is an empty mountpoint.
+ */
+bool
+otcore_boot_is_on_physical_root (const char *physical_root)
+{
+  g_autofree char *boot_loader = g_build_filename (physical_root, "boot/loader", NULL);
+  struct stat stbuf;
+  return lstat (boot_loader, &stbuf) == 0 && S_ISLNK (stbuf.st_mode);
+}
+
 /**
  * otcore_mount_boot:
  *
@@ -457,13 +472,12 @@ composefs_error_message (int errsv)
 gboolean
 otcore_mount_boot (const char *physical_root, const char *deployment, GError **error)
 {
-  g_autofree char *boot_loader = g_build_filename (physical_root, "boot/loader", NULL);
   struct stat stbuf;
 
   /* If /boot is on the same partition, use a bind mount to make it visible
    * at /boot inside the deployment.
    */
-  if (!(lstat (boot_loader, &stbuf) == 0 && S_ISLNK (stbuf.st_mode)))
+  if (!otcore_boot_is_on_physical_root (physical_root))
     return TRUE;
 
   g_autofree char *target_boot = g_build_filename (deployment, "boot", NULL);
diff --git a/src/libotcore/otcore.h b/src/libotcore/otcore.h
index 68696b32..0f56c95a 100644
--- a/src/libotcore/otcore.h
+++ b/src/libotcore/otcore.h
@@ -98,6 +98,7 @@ RootConfig *otcore_load_rootfs_config (const char *cmdline, GKeyFile *config, gb
 gboolean otcore_mount_rootfs (RootConfig *rootfs_config, GVariantBuilder *metadata_builder,
                               const char *root_mountpoint, const char *deploy_path,
                               const char *mount_target, bool *out_using_composefs, GError **error);
+bool otcore_boot_is_on_physical_root (const char *physical_root);
 gboolean otcore_mount_boot (const char *physical_root, const char *deploy_path, GError **error);
 
 gboolean otcore_mount_etc (GKeyFile *config, GVariantBuilder *metadata_builder,
-- 
