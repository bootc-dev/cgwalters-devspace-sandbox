# Tools for bootc's `just build` and `cargo xtask run-tmt` (bcvk with a
# libvirt session), on top of Containerfile.vmhost, for hosts without them.
# Run it like vmhost, plus -v ~/src:/src.
FROM localhost/vmhost
RUN dnf -y --disablerepo=fedora-cisco-openh264 install libvirt-daemon-kvm libvirt-client edk2-ovmf tmt just cargo rust rsync gcc git make \
      openssl xorriso which && dnf clean all
