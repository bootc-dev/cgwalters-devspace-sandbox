 gboolean _ostree_sysroot_query_bootloader (OstreeSysroot *sysroot,
                                            OstreeBootloader **out_bootloader,
                                            GCancellable *cancellable, GError **error);
diff --git a/src/libostree/ostree-sysroot.c b/src/libostree/ostree-sysroot.c
index daa582cb..77002822 100644
--- a/src/libostree/ostree-sysroot.c
+++ b/src/libostree/ostree-sysroot.c
@@ -353,29 +353,37 @@ validate_boot_fd (OstreeSysroot *self, int fd, GError **error)
   return TRUE;
 }
 
-/* Path to the boot filesystem of a booted system. When /boot is a directory of
- * the physical root, the deployment's /boot is only a bind mount of it made by
- * ostree-system-generator, and other units can stack an automount on that
- * path; systemd-gpt-auto-generator does for an unused ESP, e.g. when booted
- * via BIOS. Once that automount expires, /boot is no longer reachable from
- * another mount namespace (EPERM), so use the source, which always is.
- * Returns a string literal.
+/* Open the boot/ directory, or return -1 with errno set.
+ *
+ * On a booted system, never depend on the /boot path: other units can stack
+ * an automount there (systemd-gpt-auto-generator does for an unused ESP, e.g.
+ * when booted via BIOS), and once that expires, /boot is no longer reachable
+ * from another mount namespace (EPERM). When /boot is a directory of the
+ * physical root, the deployment's /boot is only a bind mount of it made by
+ * ostree-system-generator, so use the source, which always is reachable.
+ * Otherwise use a detached mount of the boot filesystem.
  */
-static const char *
-booted_boot_path (void)
-{
-  if (otcore_boot_is_on_physical_root ("/sysroot"))
-    return "/sysroot/boot";
-  return "/boot";
-}
-
-/* Open the boot/ directory, or return -1 with errno set */
 static int
 open_boot_dir (OstreeSysroot *self)
 {
-  if (self->root_is_ostree_booted)
-    return glnx_opendirat_with_errno (AT_FDCWD, booted_boot_path (), TRUE);
-  return glnx_opendirat_with_errno (self->sysroot_fd, "boot", TRUE);
+  self->boot_is_detached = FALSE;
+  if (!self->root_is_ostree_booted)
+    return glnx_opendirat_with_errno (self->sysroot_fd, "boot", TRUE);
+  if (otcore_boot_is_on_physical_root ("/sysroot"))
+    return glnx_opendirat_with_errno (AT_FDCWD, "/sysroot/boot", TRUE);
+  /* Unprivileged callers can only read, from their own mount namespace, in
+   * which accessing /boot triggers the automount if there is one. */
+  if (ot_util_process_privileged ())
+    {
+      int fd = _ostree_bootfs_open_detached ();
+      if (fd >= 0)
+        {
+          self->boot_is_detached = TRUE;
+          return fd;
+        }
+      g_debug ("Opening a detached mount of /boot: %s; using the path", g_strerror (errno));
+    }
+  return glnx_opendirat_with_errno (AT_FDCWD, "/boot", TRUE);
 }
 
 /* Require that both self->sysroot_fd is set.
@@ -478,10 +486,16 @@ _ostree_sysroot_ensure_writable (OstreeSysroot *self, GError **error)
 
   /* When /boot is a directory of the physical root, boot_fd is opened from
    * /sysroot/boot, which is now writable. /boot is then only a bind mount of it
-   * that may have an automount stacked on top (see booted_boot_path()), so
-   * leave it alone. Otherwise /boot is its own filesystem; remount it.
+   * that may have an automount stacked on top (see open_boot_dir()), so
+   * leave it alone. Otherwise /boot is its own filesystem; make it writable
+   * through our detached mount of it if we have one, else remount /boot.
    */
-  if (!otcore_boot_is_on_physical_root ("/sysroot"))
+  if (self->boot_is_detached)
+    {
+      if (!_ostree_bootfs_ensure_writable (self->boot_fd, error))
+        return FALSE;
+    }
+  else if (!otcore_boot_is_on_physical_root ("/sysroot"))
     {
       gboolean did_remount_boot = FALSE;
       if (!remount_writable ("/boot", &did_remount_boot, error))
